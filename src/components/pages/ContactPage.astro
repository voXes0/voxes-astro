---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SocialIcon from "@/components/icons/SocialIcon.astro";
import PageShell from "@/components/PageShell.astro";
import PageHeader from "@/components/PageHeader.astro";
import { t, type Locale } from "@/i18n";
import { getSocials } from "@/lib/socials";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).contact;
const items = getSocials(locale);
---

<BaseLayout
  locale={locale}
  title={m.meta.title}
  description={m.meta.description}
>
  <PageShell>
    <div class="shell">
      <PageHeader
        eyebrow={m.eyebrow}
        title={`${m.title1}${m.title2}`}
        intro={m.intro}
      />

      <ul class="list" role="list">
        {
          items.map((s) => (
            <li class="item">
              <a
                class="row"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="icon">
                  <SocialIcon name={s.id} />
                </span>
                <span class="label">
                  {s.label}
                  <span class="sr-only"> {m.newTab}</span>
                </span>
                <span class="desc">{s.description}</span>
                <span class="handle" dir="ltr">
                  {s.handle}
                </span>
                <span class="arrow">
                  <SocialIcon name="arrow-up-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .shell {
    max-width: 62rem;
    margin-inline: auto;
  }

  /* Ruled list: one column on phones, two from 900px. */
  .list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 3rem;
    border-block-end: 1px solid var(--low-opacity-soft-foreground);
  }
  @media (min-width: 900px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .item {
    border-block-start: 1px solid var(--low-opacity-soft-foreground);
  }

  /* Each row is one link: icon | label, desc, handle | arrow. */
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "icon label arrow"
      "icon desc arrow"
      "icon handle arrow";
    column-gap: 1rem;
    row-gap: 0.1rem;
    align-items: center;
    padding-block: 1rem;
    color: var(--soft-foreground);
    text-decoration: none;
  }
  .row:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: -3px;
    border-radius: 0.75rem;
  }

  .icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid var(--low-opacity-soft-foreground);
    border-radius: 50%;
    font-size: 1.1rem;
    color: var(--soft-foreground);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }
  .label {
    grid-area: label;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    transition: color 0.25s ease;
  }
  .desc {
    grid-area: desc;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--high-opacity-soft-foreground);
  }
  .handle {
    grid-area: handle;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--softer-foreground);
    overflow-wrap: anywhere;
  }
  .arrow {
    grid-area: arrow;
    display: inline-grid;
    font-size: 1rem;
    color: var(--softer-foreground);
    transition:
      translate 0.3s ease,
      color 0.25s ease;
  }
  /* The arrow points up and toward the inline end: mirror it in RTL. */
  .arrow:dir(rtl) {
    scale: -1 1;
  }

  .row:hover .icon,
  .row:focus-visible .icon {
    background: var(--secondary);
    border-color: var(--secondary);
    color: var(--background);
  }
  .row:hover .label,
  .row:focus-visible .label {
    color: var(--secondary);
  }
  .row:hover .arrow,
  .row:focus-visible .arrow {
    color: var(--secondary);
    translate: 0.2rem -0.2rem;
  }
  .row:dir(rtl):hover .arrow,
  .row:dir(rtl):focus-visible .arrow {
    translate: -0.2rem -0.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon,
    .label,
    .arrow {
      transition: none;
    }
    .row:hover .arrow,
    .row:focus-visible .arrow,
    .row:dir(rtl):hover .arrow,
    .row:dir(rtl):focus-visible .arrow {
      translate: none;
    }
  }
</style>
