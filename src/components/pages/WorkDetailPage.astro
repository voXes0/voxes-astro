---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseStudy from "@/components/CaseStudy.astro";
import PageShell from "@/components/PageShell.astro";
import TextLink from "@/components/TextLink.astro";
import { t, type Locale } from "@/i18n";
import { getCaseStudy } from "@/i18n/case-studies";
import { localizedHref } from "@/lib/navigation";
import { getWork } from "@/lib/works";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const m = t(locale).works;
const work = getWork(slug, locale);
if (!work) throw new Error(`works: no work with slug "${slug}"`);
// Projects without a case study (src/i18n/case-studies) fall back to the stub below.
const study = getCaseStudy(slug, locale);
---

<BaseLayout
  locale={locale}
  title={m.detail.metaTitle.replace("{title}", work.title)}
  description={work.description}
>
  {
    study ? (
      <CaseStudy locale={locale} work={work} study={study} />
    ) : (
      <PageShell long>
        <div class="shell">
          <div class="back">
            <TextLink href={localizedHref("/works", locale)}>{m.detail.back}</TextLink>
          </div>
          <h1 class="title">{work.title}</h1>
          <p class="desc">{work.description}</p>
          <p class="soon">{m.detail.comingSoon}</p>
        </div>
      </PageShell>
    )
  }
</BaseLayout>

<style>
  .shell {
    max-width: 44rem;
    margin-inline: auto;
  }
  .back {
    margin-block-end: 2rem;
  }
  .title {
    margin-block-end: 1rem;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--soft-foreground);
  }
  .desc {
    margin-block-end: 2rem;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--soft-foreground);
  }
  .soon {
    padding: 1rem 1.25rem;
    border: 1.5px dashed var(--low-opacity-soft-foreground);
    border-radius: 1rem;
    color: var(--mid-opacity-soft-foreground);
  }
</style>
