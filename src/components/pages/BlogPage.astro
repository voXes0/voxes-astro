---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageShell from "@/components/PageShell.astro";
import FilterPills from "@/components/FilterPills.astro";
import ChipList from "@/components/ChipList.astro";
import { t, type Locale } from "@/i18n";
import { localizedHref } from "@/lib/navigation";
import { blogTopics, getPosts } from "@/lib/blog";
import styles from "./BlogPage.module.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).blog;
const items = getPosts(locale);

// fa-IR gives Persian digits and the Solar Hijri calendar; en-US stays Gregorian.
const intlLocale = locale === "fa" ? "fa-IR" : "en-US";
const dateFmt = new Intl.DateTimeFormat(intlLocale, {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const numFmt = new Intl.NumberFormat(intlLocale);
const fmtDate = (iso: string) => dateFmt.format(new Date(`${iso}T00:00:00Z`));
const fmtRead = (n: number) => m.readTime.replace("{n}", numFmt.format(n));

const filters = [
  { value: "all", label: m.filters.all, count: items.length },
  ...blogTopics.map((topic) => ({
    value: topic,
    label: m.topics[topic],
    count: items.filter((p) => p.topic === topic).length,
  })),
]
  .filter((f) => f.count > 0)
  .map((f) => ({ ...f, count: numFmt.format(f.count) }));
---

<BaseLayout
  locale={locale}
  title={m.meta.title}
  description={m.meta.description}
>
  <PageShell long>
    <div class={styles.shell}>
      <PageHeader
        size="lg"
        eyebrow={m.eyebrow}
        title={`${m.title1}${m.title2}`}
        intro={m.intro}
      />

      <FilterPills name="blog-filter" label={m.filterLabel} filters={filters} />

      <ul class={styles.list} role="list">
        {
          items.map((p) => (
            <li class={styles.item} data-filter-value={p.topic}>
              <article class:list={[styles.post, p.thumbnail && styles["has-thumb"]]}>
                <div class={styles.meta}>
                  <time class={styles.date} datetime={p.date}>
                    {fmtDate(p.date)}
                  </time>
                  <span class={styles.read}>{fmtRead(p.minutes)}</span>
                </div>

                <div class={styles.body}>
                  <span class={styles.topic}>{m.topics[p.topic]}</span>
                  <h2 class={styles.name}>
                    <a
                      class="stretched-link"
                      href={localizedHref(`/blog/${p.slug}`, locale)}
                    >
                      {p.title}
                    </a>
                  </h2>
                  <p class={styles.desc}>{p.description}</p>

                  <div class={styles.tags}>
                    <ChipList items={p.tags} dir="auto" />
                  </div>
                </div>

                <div class={styles.aside}>
                  {p.thumbnail && (
                    <span class={styles.thumb}>
                      <img
                        src={p.thumbnail}
                        alt=""
                        width="600"
                        height="400"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  )}
                  <span class={styles.go} aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      width="22"
                      height="22"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </PageShell>
</BaseLayout>
