---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageShell from "@/components/PageShell.astro";
import FilterPills from "@/components/FilterPills.astro";
import ChipList from "@/components/ChipList.astro";
import WorkLinks from "@/components/WorkLinks.astro";
import { t, type Locale } from "@/i18n";
import { localizedHref } from "@/lib/navigation";
import WorkMeta from "@/components/WorkMeta.astro";
import { getWorks } from "@/lib/works";
import styles from "./WorksPage.module.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).works;
const items = getWorks(locale);

const counts = {
  all: items.length,
  open: items.filter((w) => w.kind === "open").length,
  closed: items.filter((w) => w.kind === "closed").length,
};

const filters = [
  { value: "all", label: m.filters.all, count: counts.all },
  { value: "open", label: m.filters.open, count: counts.open },
  { value: "closed", label: m.filters.closed, count: counts.closed },
].map((f) => ({ ...f, count: String(f.count) }));
---

<BaseLayout
  locale={locale}
  title={m.meta.title}
  description={m.meta.description}
>
  <!-- Clip shape shared by every work's frame: a pointed arch (Azadi-style
       silhouette), in bounding-box units so it scales with the frame. -->
  <svg
    width="0"
    height="0"
    aria-hidden="true"
    focusable="false"
    class={styles.defs}
  >
    <defs>
      <clipPath id="works-arch" clipPathUnits="objectBoundingBox">
        <path d="M0,1 V0.42 C0,0.24 0.3,0.09 0.5,0 C0.7,0.09 1,0.24 1,0.42 V1 Z"
        ></path>
      </clipPath>
      <!-- Same silhouette redrawn for a wide frame (phones), where the
           shoulders sit lower so the point doesn't read as a flat dome. -->
      <clipPath id="works-arch-wide" clipPathUnits="objectBoundingBox">
        <path d="M0,1 V0.58 C0,0.4 0.2,0.16 0.5,0 C0.8,0.16 1,0.4 1,0.58 V1 Z"
        ></path>
      </clipPath>
    </defs>
  </svg>

  <PageShell long>
    <div class={styles.shell}>
      <PageHeader
        size="lg"
        eyebrow={m.eyebrow}
        title={`${m.title1}${m.title2}`}
        intro={m.intro}
      />

      <FilterPills
        name="works-filter"
        label={m.filterLabel}
        filters={filters}
      />

      <ul class={styles.list} role="list">
        {
          items.map((w) => (
            <li class={styles.item} data-filter-value={w.kind}>
              <article class={styles.work}>
                <div class={styles.arch}>
                  <div class={styles["arch-inner"]}>
                    {w.image ? (
                      <img
                        class={styles.art}
                        src={w.image.src}
                        width={w.image.width}
                        height={w.image.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class:list={[styles.art, styles.placeholder]} data-pattern={w.pattern}>
                        <span class={styles.medallion} aria-hidden="true">
                          {Array.from(w.title)[0]}
                        </span>
                      </div>
                    )}
                  </div>
                </div>

                <div class={styles.body}>
                  <div class={styles["meta-row"]}>
                    <WorkMeta
                      locale={locale}
                      kind={w.kind}
                      status={w.status}
                      year={w.year}
                    />
                  </div>

                  <h2 class={styles.name}>
                    <a
                      class="stretched-link"
                      href={localizedHref(`/works/${w.slug}`, locale)}
                    >
                      {w.title}
                    </a>
                  </h2>
                  <p class={styles.desc}>{w.description}</p>

                  <div class={styles.tech}>
                    <ChipList items={w.tech} />
                  </div>

                  <div class={styles.links}>
                    <WorkLinks locale={locale} work={w} touch />
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </PageShell>
</BaseLayout>
