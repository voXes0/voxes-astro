---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageShell from "@/components/PageShell.astro";
import FilterPills from "@/components/FilterPills.astro";
import ChipList from "@/components/ChipList.astro";
import WorkLinks from "@/components/WorkLinks.astro";
import { t, type Locale } from "@/i18n";
import { localizedHref } from "@/lib/navigation";
import WorkMeta from "@/components/WorkMeta.astro";
import { getWorks } from "@/lib/works";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).works;
const items = getWorks(locale);

const counts = {
  all: items.length,
  open: items.filter((w) => w.kind === "open").length,
  closed: items.filter((w) => w.kind === "closed").length,
};

const filters = [
  { value: "all", label: m.filters.all, count: counts.all },
  { value: "open", label: m.filters.open, count: counts.open },
  { value: "closed", label: m.filters.closed, count: counts.closed },
].map((f) => ({ ...f, count: String(f.count) }));
---

<BaseLayout
  locale={locale}
  title={m.meta.title}
  description={m.meta.description}
>
  <!-- Clip shape shared by every work's frame: a pointed arch (Azadi-style
       silhouette), in bounding-box units so it scales with the frame. -->
  <svg
    width="0"
    height="0"
    aria-hidden="true"
    focusable="false"
    style="position: absolute"
  >
    <defs>
      <clipPath id="works-arch" clipPathUnits="objectBoundingBox">
        <path
          d="M0,1 V0.42 C0,0.24 0.3,0.09 0.5,0 C0.7,0.09 1,0.24 1,0.42 V1 Z"
        ></path>
      </clipPath>
      <!-- Same silhouette redrawn for a wide frame (phones), where the
           shoulders sit lower so the point doesn't read as a flat dome. -->
      <clipPath id="works-arch-wide" clipPathUnits="objectBoundingBox">
        <path
          d="M0,1 V0.58 C0,0.4 0.2,0.16 0.5,0 C0.8,0.16 1,0.4 1,0.58 V1 Z"
        ></path>
      </clipPath>
    </defs>
  </svg>

  <PageShell long>
    <div class="shell">
      <PageHeader size="lg" eyebrow={m.eyebrow} title={`${m.title1}${m.title2}`} intro={m.intro} />

      <FilterPills name="works-filter" label={m.filterLabel} filters={filters} />

      <ul class="list" role="list">
        {
          items.map((w) => (
            <li class="item" data-filter-value={w.kind}>
              <article class="work">
                <div class="arch">
                  <div class="arch-inner">
                    {w.image ? (
                      <img
                        class="art"
                        src={w.image.src}
                        width={w.image.width}
                        height={w.image.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="art placeholder" data-pattern={w.pattern}>
                        <span class="medallion" aria-hidden="true">
                          {Array.from(w.title)[0]}
                        </span>
                      </div>
                    )}
                  </div>
                </div>

                <div class="body">
                  <div class="meta-row">
                    <WorkMeta
                      locale={locale}
                      kind={w.kind}
                      status={w.status}
                      year={w.year}
                    />
                  </div>

                  <h2 class="name">
                    <a class="stretched-link" href={localizedHref(`/works/${w.slug}`, locale)}>
                      {w.title}
                    </a>
                  </h2>
                  <p class="desc">{w.description}</p>

                  <div class="tech">
                    <ChipList items={w.tech} />
                  </div>

                  <div class="links">
                    <WorkLinks locale={locale} work={w} touch />
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .shell {
    max-width: 68rem;
    margin-inline: auto;
  }

  /* ── List ── */
  .list {
    border-block-start: 1px solid var(--low-opacity-soft-foreground);
  }
  .item {
    border-block-end: 1px solid var(--low-opacity-soft-foreground);
  }

  /* Phones: arch banner above the details. From 640px: image beside text. */
  .work {
    position: relative;
    display: grid;
    gap: 1.1rem;
    padding-block: 1.75rem 1.5rem;
    -webkit-tap-highlight-color: transparent;
  }
  .body {
    min-width: 0;
  }
  .meta-row {
    margin-block-end: 0.7rem;
  }
  .name {
    margin-block-end: 0.6rem;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--soft-foreground);
    overflow-wrap: anywhere;
  }

  @media (min-width: 640px) {
    .work {
      --thumb: 12rem;
      grid-template-columns: var(--thumb) minmax(0, 1fr);
      column-gap: 2rem;
      align-items: start;
      padding-block: 2.5rem;
    }
    .meta-row {
      margin-block-end: 1rem;
    }
    .name {
      margin-block-end: 0.75rem;
      font-size: clamp(1.5rem, 3vw, 2rem);
    }
  }
  @media (min-width: 720px) {
    .work {
      --thumb: 13.5rem;
      column-gap: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .work {
      --thumb: 16rem;
      column-gap: 3.5rem;
    }
  }

  /* ── Arch frame ──
     The outer shape is the border colour; the inner shape is inset by the ring
     width, so the "stroke" follows the arch. It's a size container so the
     placeholder artwork scales with the frame (cqw). */
  .arch {
    --ring: 4px;
    --clip: url(#works-arch-wide);
    --tile: 12cqw;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    container-type: inline-size;
    background: var(--softer-foreground);
    clip-path: var(--clip);
    transition: background-color 0.35s ease;
  }
  @media (min-width: 440px) {
    .arch {
      aspect-ratio: 2 / 1;
    }
  }
  @media (min-width: 640px) {
    .arch {
      --ring: 5px;
      --clip: url(#works-arch);
      --tile: 14cqw;
      aspect-ratio: 4 / 5;
    }
  }
  .arch-inner {
    position: absolute;
    inset: var(--ring);
    overflow: hidden;
    background: var(--background);
    clip-path: var(--clip);
  }
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  /* Placeholder until a real image is supplied: a patterned field with a
     medallion. Everything derives from --tile (a cqw length). */
  .placeholder {
    display: grid;
    place-items: center;
    background-color: var(--background);
  }
  .placeholder[data-pattern="1"] {
    background-image:
      linear-gradient(135deg, var(--low-opacity-secondary) 25%, transparent 25%),
      linear-gradient(225deg, var(--low-opacity-secondary) 25%, transparent 25%),
      linear-gradient(45deg, var(--low-opacity-secondary) 25%, transparent 25%),
      linear-gradient(315deg, var(--low-opacity-secondary) 25%, transparent 25%);
    background-size: var(--tile) var(--tile);
    background-position:
      calc(var(--tile) / 2) 0,
      calc(var(--tile) / 2) 0,
      0 0,
      0 0;
  }
  .placeholder[data-pattern="2"] {
    background-image: repeating-linear-gradient(
      -45deg,
      var(--low-opacity-secondary) 0 calc(var(--tile) / 6),
      transparent calc(var(--tile) / 6) calc(var(--tile) / 2)
    );
  }
  .placeholder[data-pattern="3"] {
    background-image: radial-gradient(
      circle,
      var(--low-opacity-secondary) calc(var(--tile) / 12),
      transparent calc(var(--tile) / 10)
    );
    background-size: calc(var(--tile) * 0.6) calc(var(--tile) * 0.6);
  }
  .medallion {
    display: grid;
    place-items: center;
    /* Wide frame: sized by height so it stays round and clear of the edges. */
    height: 46%;
    aspect-ratio: 1;
    margin-block-start: 8%;
    border: 2px solid var(--softer-foreground);
    border-radius: 50%;
    background: var(--background);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
    color: var(--secondary);
  }
  @media (min-width: 640px) {
    .medallion {
      width: 42%;
      height: auto;
      margin-block-start: 18%; /* sit in the arch's wide lower body */
      font-size: 17cqw;
      border-width: clamp(1.5px, 0.8cqw, 2px);
    }
  }

  /* Hover only where it exists: on touch screens :hover sticks after a tap,
     so presses get :active instead. */
  @media (hover: hover) {
    .work:hover .arch {
      background: var(--secondary);
    }
    .work:hover .art {
      transform: scale(1.05);
    }
    .work:hover .name a {
      color: var(--secondary);
    }
  }
  .work:has(.name a:focus-visible) .arch,
  .work:has(.name a:active) .arch {
    background: var(--secondary);
  }
  .work:has(.name a:focus-visible) .art {
    transform: scale(1.05);
  }
  .work:has(.name a:active) .name a {
    color: var(--secondary);
  }

  /* ── Body ── */
  .desc {
    max-width: 38rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--high-opacity-soft-foreground);
  }
  @media (min-width: 640px) {
    .desc {
      margin-block-end: 1.25rem;
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  .tech {
    margin-block-start: 0.85rem;
  }
  @media (min-width: 640px) {
    .tech {
      margin-block-start: 0;
    }
  }
  .links {
    margin-block-start: 0.5rem;
  }
  @media (min-width: 640px) {
    .links {
      margin-block-start: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch,
    .art {
      transition: none;
    }
    .work:hover .art,
    .work:has(.name a:focus-visible) .art {
      transform: none;
    }
  }
</style>
