---
/**
 * Radio-pill filter for a list on the same page. The first filter is the
 * default and should be "all". List items opt in with
 * `data-filter-value="<value>"` and are hidden by CSS alone (`main:has(:checked)`), so it needs no
 * script and survives the client-side router's body swap. One filtered list
 * per page: every `[data-filter-value]` in the <main> responds to it.
 */

import styles from "./FilterPills.module.css";

interface Filter {
  value: string;
  label: string;
  /** Already formatted for the locale. */
  count: string;
}

interface Props {
  /** Radio group name; also prefixes the input ids, so keep it unique per page. */
  name: string;
  /** Screen-reader label for the group. */
  label: string;
  filters: Filter[];
}

const { name, label, filters } = Astro.props;
const idOf = (value: string) => `${name}-${value}`;

const hideRules = filters
  .slice(1)
  .map(
    (f) =>
      `main:has(#${idOf(f.value)}:checked) [data-filter-value]:not([data-filter-value="${f.value}"]) { display: none; }`,
  )
  .join("\n");
---

<div class={styles["filters-wrap"]}>
  <fieldset class={styles.filters}>
    <legend class="sr-only">{label}</legend>
    {
      filters.map((f, i) => (
        <>
          <input type="radio" name={name} id={idOf(f.value)} checked={i === 0} />
          <label for={idOf(f.value)}>
            {f.label}
            <span class={styles.count}>{f.count}</span>
          </label>
        </>
      ))
    }
  </fieldset>
</div>
<style is:inline set:html={hideRules}></style>
