---
import type { CaseFigure } from "@/i18n/case-studies";
import { galleryData, toSlides } from "@/lib/gallery";
import { localeFromPathname } from "@/lib/navigation";
import styles from "./WorkFigure.module.css";

interface Props {
  figure: CaseFigure;
  /** Text shown inside the frame while there's no real image. */
  placeholderLabel: string;
  /** Load eagerly (above the fold). Default lazy. */
  eager?: boolean;
}

const { figure, placeholderLabel, eager = false } = Astro.props;
const ratio = figure.ratio ?? "16 / 10";
const slides = figure.src ? toSlides(figure.src, figure.alt) : [];
const [first] = slides;
---

<figure class={styles.fig} style={figure.size ? `max-width: ${figure.size}` : undefined}>
  <!-- Double border: outer line, gap, inner image. -->
  <div class={styles.frame}>
    <div
      class={styles.well}
      style={`aspect-ratio: ${ratio}`}
      data-gallery={first && galleryData(localeFromPathname(Astro.url.pathname), slides, figure.autoplay)}
    >
      {
        first ? (
          <img
            src={first.src}
            width={figure.width}
            height={figure.height}
            alt={first.alt}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <div class={styles.ph} role="img" aria-label={[figure.alt].flat()[0]}>
            <span class={styles["ph-label"]}>{placeholderLabel}</span>
          </div>
        )
      }
    </div>
  </div>
  <figcaption>{figure.caption}</figcaption>
</figure>
