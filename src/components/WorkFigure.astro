---
import type { CaseFigure } from "@/i18n/case-studies";

interface Props {
  figure: CaseFigure;
  /** Text shown inside the frame while there's no real image. */
  placeholderLabel: string;
  /** Load eagerly (above the fold). Default lazy. */
  eager?: boolean;
}

const { figure, placeholderLabel, eager = false } = Astro.props;
const ratio = figure.ratio ?? "16 / 10";
---

<figure class="fig">
  <!-- Double border: outer line, gap, inner image. -->
  <div class="frame">
    <div class="well" style={`aspect-ratio: ${ratio}`}>
      {
        figure.src ? (
          <img
            src={figure.src}
            width={figure.width}
            height={figure.height}
            alt={figure.alt}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <div class="ph" role="img" aria-label={figure.alt}>
            <span class="ph-label">{placeholderLabel}</span>
          </div>
        )
      }
    </div>
  </div>
  <figcaption>{figure.caption}</figcaption>
</figure>

<style>
  .frame {
    padding: 6px;
    border: 2px solid var(--softer-foreground);
    border-radius: 1.25rem;
  }
  .well {
    position: relative;
    overflow: hidden;
    border-radius: 0.8rem;
    background: var(--background);
  }
  .well img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-image: radial-gradient(
      circle,
      var(--low-opacity-secondary) 2.5px,
      transparent 3px
    );
    background-size: 22px 22px;
  }
  .ph-label {
    padding: 0.45rem 1.1rem;
    border: 1.5px solid var(--softer-foreground);
    border-radius: var(--radius-pill);
    background: var(--background);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--secondary);
  }
  figcaption {
    margin-block-start: 0.75rem;
    padding-inline: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--mid-opacity-soft-foreground);
  }
</style>
