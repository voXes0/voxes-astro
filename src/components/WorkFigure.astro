---
import type { CaseFigure } from "@/i18n/case-studies";
import styles from "./WorkFigure.module.css";

interface Props {
  figure: CaseFigure;
  /** Text shown inside the frame while there's no real image. */
  placeholderLabel: string;
  /** Load eagerly (above the fold). Default lazy. */
  eager?: boolean;
}

const { figure, placeholderLabel, eager = false } = Astro.props;
const ratio = figure.ratio ?? "16 / 10";
---

<figure class={styles.fig}>
  <!-- Double border: outer line, gap, inner image. -->
  <div class={styles.frame}>
    <div class={styles.well} style={`aspect-ratio: ${ratio}`}>
      {
        figure.src ? (
          <img
            src={figure.src}
            width={figure.width}
            height={figure.height}
            alt={figure.alt}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <div class={styles.ph} role="img" aria-label={figure.alt}>
            <span class={styles["ph-label"]}>{placeholderLabel}</span>
          </div>
        )
      }
    </div>
  </div>
  <figcaption>{figure.caption}</figcaption>
</figure>
