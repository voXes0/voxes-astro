---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseStudy from "@/components/CaseStudy.astro";
import PageShell from "@/components/PageShell.astro";
import TextLink from "@/components/TextLink.astro";
import { t, type Locale } from "@/i18n";
import { getCaseStudy } from "@/i18n/case-studies";
import { localizedHref } from "@/lib/navigation";
import { getWork } from "@/data/works";
import styles from "./WorkDetailPage.module.css";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const m = t(locale).works;
const work = getWork(slug, locale);
if (!work) throw new Error(`works: no work with slug "${slug}"`);
// Projects without a case study (src/i18n/case-studies) fall back to the stub below.
const study = getCaseStudy(slug, locale);
---

<BaseLayout
  locale={locale}
  title={m.detail.metaTitle.replace("{title}", work.title)}
  description={work.description}
>
  <div class={styles.page}>
    {
      study ? (
        <CaseStudy locale={locale} work={work} study={study} />
      ) : (
        <PageShell long>
          <div class={styles.shell}>
            <div class={styles.back}>
              <TextLink href={localizedHref("/works", locale)}>
                {m.detail.back}
              </TextLink>
            </div>
            <h1 class={styles.title}>{work.title}</h1>
            <p class={styles.desc}>{work.description}</p>
            <p class={styles.soon}>{m.detail.comingSoon}</p>
          </div>
        </PageShell>
      )
    }
  </div>
</BaseLayout>
