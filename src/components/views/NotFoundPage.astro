---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import FlappyBird from "@/components/FlappyBird.astro";
import PageShell from "@/components/PageShell.astro";
import PageHeader from "@/components/PageHeader.astro";
import { t, type Locale } from "@/i18n";
import { localizedHref } from "@/lib/navigation";
import styles from "@/components/views/NotFoundPage.module.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).notFound;
---

<BaseLayout locale={locale} title={m.title} description={m.description}>
  <PageShell center data-not-found={locale}>
    <div class={styles.shell}>
      <PageHeader
        eyebrow={m.eyebrow}
        title={`${m.title1}${m.title2}`}
        intro={m.intro}
        flush
        titleSize="clamp(2.2rem, 5.5vw, 3.2rem)"
        introMax="30rem"
      >
        <div class={styles.actions}>
          <ButtonLink
            variant="primary"
            href={localizedHref("/", locale)}
            class={styles.btnLink}
          >
            {m.home}
          </ButtonLink>
          <ButtonLink
            variant="secondary"
            href={localizedHref("/works", locale)}
            class={styles.btnLink}
          >
            {m.works}
          </ButtonLink>
        </div>
      </PageHeader>

      <div class={styles.game}>
        <FlappyBird locale={locale} />
      </div>
    </div>
  </PageShell>
</BaseLayout>
