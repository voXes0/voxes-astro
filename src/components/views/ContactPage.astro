---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SocialIcon from "@/components/icons/SocialIcon.astro";
import PageShell from "@/components/PageShell.astro";
import PageHeader from "@/components/PageHeader.astro";
import { t, type Locale } from "@/i18n";
import { getSocials } from "@/data/socials";
import styles from "./ContactPage.module.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).contact;
const items = getSocials(locale);
---

<BaseLayout
  locale={locale}
  title={m.meta.title}
  description={m.meta.description}
>
  <PageShell>
    <div class={styles.shell}>
      <PageHeader
        eyebrow={m.eyebrow}
        title={`${m.title1}${m.title2}`}
        intro={m.intro}
      />

      <ul class={styles.list} role="list">
        {
          items.map((s) => (
            <li class={styles.item}>
              <a
                class={styles.row}
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class={styles.icon}>
                  <SocialIcon name={s.id} />
                </span>
                <span class={styles.label}>
                  {s.label}
                  <span class="sr-only"> {m.newTab}</span>
                </span>
                <span class={styles.desc}>{s.description}</span>
                <span class={styles.handle} dir="ltr">
                  {s.handle}
                </span>
                <span class={styles.arrow}>
                  <SocialIcon name="arrow-up-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </PageShell>
</BaseLayout>
