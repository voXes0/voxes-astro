---
/** Typography for a post's body. Pass the post's language so RTL and fonts follow it. */
import { isRtl, type Locale } from "@/i18n";
import styles from "./Prose.module.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class={styles.prose}
  lang={locale}
  dir={isRtl(locale) ? "rtl" : "ltr"}
  data-alt-lang={locale}
>
  <slot />
</div>
