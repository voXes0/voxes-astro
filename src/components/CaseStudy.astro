---
import ButtonLink from "@/components/ButtonLink.astro";
import ChipList from "@/components/ChipList.astro";
import PageShell from "@/components/PageShell.astro";
import SectionToc from "@/components/SectionToc.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TextLink from "@/components/TextLink.astro";
import WorkLinks from "@/components/WorkLinks.astro";
import WorkMeta from "@/components/WorkMeta.astro";
import WorkFigure from "@/components/WorkFigure.astro";
import { t, type Locale } from "@/i18n";
import type { CaseStudy } from "@/i18n/case-studies";
import { localizedHref } from "@/lib/navigation";
import { spyName, spyScope } from "@/lib/sectionSpy";
import type { Work } from "@/lib/works";
import styles from "./CaseStudy.module.css";

interface Props {
  locale: Locale;
  work: Work;
  study: CaseStudy;
}

const { locale, work, study } = Astro.props;
const m = t(locale).works;
const d = m.detail;
const ph = d.imagePlaceholder;

const timelineScope = spyScope(study.sections.map((sec) => sec.id));
---

<PageShell long>
  <div class={styles.shell}>
    <header class={styles.hero}>
      <div class={styles.back}>
        <TextLink href={localizedHref("/works", locale)}>{d.back}</TextLink>
      </div>
      <div class={styles["meta-row"]}>
        <WorkMeta
          locale={locale}
          kind={work.kind}
          status={work.status}
          year={Number(work.date.slice(0, 4))}
        />
      </div>
      <h1 class={styles.title}>{work.title}</h1>
      <p class={styles.lead}>{study.lead}</p>

      <dl class={styles.facts}>
        {
          study.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="tech">
        <ChipList items={work.tech} />
      </div>

      <div class={styles.links}>
        <WorkLinks locale={locale} work={work} />
      </div>
    </header>

    <div class={styles["hero-fig"]}>
      <WorkFigure figure={study.hero} placeholderLabel={ph} eager />
    </div>

    <div class={styles.layout} style={`timeline-scope: ${timelineScope}`}>
      <SectionToc label={d.toc} items={study.sections} spy />

      <div class={styles.content}>
        {
          study.sections.map((s) => (
            <section
              id={s.id}
              class={styles.section}
              style={`view-timeline-name: ${spyName(s.id)}`}
            >
              <SectionHeading large tight title={s.title} />
              {s.intro && <p class={styles.intro}>{s.intro}</p>}

              {s.kind === "brief" && (
                <div class={styles.brief}>
                  <div class={styles.prose}>
                    {s.body.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                  <aside class={styles.asks}>
                    <h3>{s.asksLabel}</h3>
                    <ul role="list">
                      {s.asks.map((a) => (
                        <li>{a}</li>
                      ))}
                    </ul>
                  </aside>
                </div>
              )}

              {s.kind === "prose" && (
                <div class={styles.prose}>
                  {s.body.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              )}

              {s.kind === "timeline" && (
                <ol class={styles.timeline} role="list">
                  {s.phases.map((phase) => (
                    <li class={styles.phase}>
                      <p class={styles.period}>{phase.period}</p>
                      <h3>{phase.title}</h3>
                      <p class={styles["prose-p"]}>{phase.body}</p>
                      {phase.figure && (
                        <div class={styles["block-fig"]}>
                          <WorkFigure
                            figure={phase.figure}
                            placeholderLabel={ph}
                          />
                        </div>
                      )}
                    </li>
                  ))}
                </ol>
              )}

              {s.kind === "decisions" && (
                <ul class={styles.decisions} role="list">
                  {s.items.map((it) => (
                    <li class={styles.decision}>
                      <div class="decision-head">
                        <h3>{it.title}</h3>
                        <p class={styles.chosen}>
                          <span class={styles["chosen-label"]}>{d.chose}</span>
                          {it.choice}
                        </p>
                      </div>
                      <div class="decision-body">
                        <p class={styles["prose-p"]}>{it.why}</p>
                        {it.considered.length > 0 && (
                          <p class={styles.considered}>
                            <span>{d.considered}:</span>{" "}
                            {it.considered.join(d.listSeparator)}
                          </p>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}

              {s.kind === "challenges" && (
                <div class={styles.challenges}>
                  {s.items.map((c) => (
                    <article class={styles.challenge}>
                      <h3>{c.title}</h3>
                      <div class={styles.pair}>
                        <div>
                          <p class={styles["pair-label"]}>{d.problem}</p>
                          <p class={styles["prose-p"]}>{c.problem}</p>
                        </div>
                        <div class={styles.solution}>
                          <p class={styles["pair-label"]}>{d.solution}</p>
                          <p class={styles["prose-p"]}>{c.solution}</p>
                        </div>
                      </div>
                      {c.figure && (
                        <div class={styles["block-fig"]}>
                          <WorkFigure figure={c.figure} placeholderLabel={ph} />
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              )}

              {s.kind === "showcase" && (
                <div class={styles.showcase}>
                  {s.items.map((item) => (
                    <article class={styles.feature}>
                      <WorkFigure figure={item.figure} placeholderLabel={ph} />
                      <div class={styles["feature-text"]}>
                        <div>
                          <span class={styles["kind-tag"]}>{item.kind}</span>
                          <h3>{item.title}</h3>
                          <p class={styles["prose-p"]}>{item.body}</p>
                        </div>
                        <ul class={styles.points} role="list">
                          {item.points.map((p) => (
                            <li>{p}</li>
                          ))}
                        </ul>
                      </div>
                    </article>
                  ))}
                </div>
              )}

              {s.kind === "lessons" && (
                <>
                  <ul class={styles.lessons} role="list">
                    {s.items.map((l) => (
                      <li>
                        <h3>{l.title}</h3>
                        <p class={styles["prose-p"]}>{l.body}</p>
                      </li>
                    ))}
                  </ul>
                  {s.closing && <p class={styles.closing}>{s.closing}</p>}
                </>
              )}

              {s.figure && (
                <div class={styles["block-fig"]}>
                  <WorkFigure figure={s.figure} placeholderLabel={ph} />
                </div>
              )}
            </section>
          ))
        }

        <div class="end">
          <ButtonLink
            variant="secondary"
            href={localizedHref("/works", locale)}
          >
            {d.back}
          </ButtonLink>
        </div>
      </div>
    </div>
  </div>
</PageShell>
