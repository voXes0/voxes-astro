---
import ButtonLink from "@/components/ButtonLink.astro";
import ChipList from "@/components/ChipList.astro";
import PageShell from "@/components/PageShell.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TextLink from "@/components/TextLink.astro";
import WorkLinks from "@/components/WorkLinks.astro";
import WorkMeta from "@/components/WorkMeta.astro";
import WorkFigure from "@/components/WorkFigure.astro";
import { t, type Locale } from "@/i18n";
import type { CaseStudy } from "@/i18n/case-studies";
import { localizedHref } from "@/lib/navigation";
import type { Work } from "@/lib/works";

interface Props {
  locale: Locale;
  work: Work;
  study: CaseStudy;
}

const { locale, work, study } = Astro.props;
const m = t(locale).works;
const d = m.detail;
const ph = d.imagePlaceholder;

// Scroll-spy for the contents list, in CSS only (the client-side router doesn't
// re-run inline scripts): each section is a named view timeline, and its link
// animates to the active style while the section crosses the reading line.
const spy = (id: string) => `--spy-${id}`;
const timelineScope = study.sections.map((s) => spy(s.id)).join(", ");
---

<PageShell long>
  <div class="shell">
    <header class="hero">
      <div class="back">
        <TextLink href={localizedHref("/works", locale)}>{d.back}</TextLink>
      </div>
      <div class="meta-row">
        <WorkMeta
          locale={locale}
          kind={work.kind}
          status={work.status}
          year={work.year}
        />
      </div>
      <h1 class="title">{work.title}</h1>
      <p class="lead">{study.lead}</p>

      <dl class="facts">
        {
          study.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="tech">
        <ChipList items={work.tech} />
      </div>

      <div class="links">
        <WorkLinks locale={locale} work={work} />
      </div>
    </header>

    <div class="hero-fig">
      <WorkFigure figure={study.hero} placeholderLabel={ph} eager />
    </div>

    <div class="layout" style={`timeline-scope: ${timelineScope}`}>
      <nav class="toc" aria-label={d.toc}>
        <p class="toc-label">{d.toc}</p>
        <ul role="list">
          {
            study.sections.map((s) => (
              <li>
                <a href={`#${s.id}`} style={`animation-timeline: ${spy(s.id)}`}>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="content">
        {
          study.sections.map((s) => (
            <section
              id={s.id}
              class="section"
              style={`view-timeline-name: ${spy(s.id)}`}
            >
              <SectionHeading large tight title={s.title} />
              {s.intro && <p class="intro">{s.intro}</p>}

              {s.kind === "brief" && (
                <div class="brief">
                  <div class="prose">
                    {s.body.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                  <aside class="asks">
                    <h3>{s.asksLabel}</h3>
                    <ul role="list">
                      {s.asks.map((a) => (
                        <li>{a}</li>
                      ))}
                    </ul>
                  </aside>
                </div>
              )}

              {s.kind === "prose" && (
                <div class="prose">
                  {s.body.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              )}

              {s.kind === "timeline" && (
                <ol class="timeline" role="list">
                  {s.phases.map((phase) => (
                    <li class="phase">
                      <p class="period">{phase.period}</p>
                      <h3>{phase.title}</h3>
                      <p class="prose-p">{phase.body}</p>
                      {phase.figure && (
                        <div class="block-fig">
                          <WorkFigure
                            figure={phase.figure}
                            placeholderLabel={ph}
                          />
                        </div>
                      )}
                    </li>
                  ))}
                </ol>
              )}

              {s.kind === "decisions" && (
                <ul class="decisions" role="list">
                  {s.items.map((it) => (
                    <li class="decision">
                      <div class="decision-head">
                        <h3>{it.title}</h3>
                        <p class="chosen">
                          <span class="chosen-label">{d.chose}</span>
                          {it.choice}
                        </p>
                      </div>
                      <div class="decision-body">
                        <p class="prose-p">{it.why}</p>
                        {it.considered.length > 0 && (
                          <p class="considered">
                            <span>{d.considered}:</span>{" "}
                            {it.considered.join(d.listSeparator)}
                          </p>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}

              {s.kind === "challenges" && (
                <div class="challenges">
                  {s.items.map((c) => (
                    <article class="challenge">
                      <h3>{c.title}</h3>
                      <div class="pair">
                        <div>
                          <p class="pair-label">{d.problem}</p>
                          <p class="prose-p">{c.problem}</p>
                        </div>
                        <div class="solution">
                          <p class="pair-label">{d.solution}</p>
                          <p class="prose-p">{c.solution}</p>
                        </div>
                      </div>
                      {c.figure && (
                        <div class="block-fig">
                          <WorkFigure figure={c.figure} placeholderLabel={ph} />
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              )}

              {s.kind === "showcase" && (
                <div class="showcase">
                  {s.items.map((item) => (
                    <article class="feature">
                      <WorkFigure figure={item.figure} placeholderLabel={ph} />
                      <div class="feature-text">
                        <div>
                          <span class="kind-tag">{item.kind}</span>
                          <h3>{item.title}</h3>
                          <p class="prose-p">{item.body}</p>
                        </div>
                        <ul class="points" role="list">
                          {item.points.map((p) => (
                            <li>{p}</li>
                          ))}
                        </ul>
                      </div>
                    </article>
                  ))}
                </div>
              )}

              {s.kind === "lessons" && (
                <>
                  <ul class="lessons" role="list">
                    {s.items.map((l) => (
                      <li>
                        <h3>{l.title}</h3>
                        <p class="prose-p">{l.body}</p>
                      </li>
                    ))}
                  </ul>
                  {s.closing && <p class="closing">{s.closing}</p>}
                </>
              )}

              {s.figure && (
                <div class="block-fig">
                  <WorkFigure figure={s.figure} placeholderLabel={ph} />
                </div>
              )}
            </section>
          ))
        }

        <div class="end">
          <ButtonLink
            variant="secondary"
            href={localizedHref("/works", locale)}
          >
            {d.back}
          </ButtonLink>
        </div>
      </div>
    </div>
  </div>
</PageShell>

<style>
  .shell {
    max-width: 72rem;
    margin-inline: auto;
  }

  .hero {
    max-width: 52rem;
  }

  .back {
    margin-block-end: 2rem;
  }
  .links {
    margin-block-start: 1.5rem;
  }
  .meta-row {
    margin-block-end: 1.25rem;
  }
  .title {
    margin-block-end: 1.5rem;
    font-size: clamp(2.8rem, 8vw, 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -2px;
    color: var(--soft-foreground);
  }
  .title:lang(fa) {
    color: var(--softer-foreground);
  }
  .lead {
    max-width: 40rem;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.75;
    color: var(--soft-foreground);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1.25rem 2rem;
    margin-block: 2.5rem 1.75rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--low-opacity-soft-foreground);
  }
  .facts dt {
    margin-block-end: 0.2rem;
    font-size: 0.8rem;
    color: var(--mid-opacity-soft-foreground);
  }
  .facts dd {
    font-weight: 600;
    color: var(--soft-foreground);
  }

  .hero-fig {
    margin-block: 3rem 4.5rem;
  }

  /* ── Page grid: sticky contents + reading column ── */
  .layout {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: 12.5rem minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .toc {
    display: none;
  }
  @media (min-width: 1100px) {
    .toc {
      display: block;
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .toc-label {
    margin-block-end: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--mid-opacity-soft-foreground);
  }
  .toc ul {
    border-inline-start: 2px solid var(--low-opacity-soft-foreground);
  }
  .toc a {
    display: block;
    padding: 0.45rem 0;
    padding-inline: 1rem 0;
    margin-inline-start: -2px;
    border-inline-start: 2px solid transparent;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--soft-foreground);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .toc a:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .toc a:hover {
    color: var(--secondary);
    border-inline-start-color: var(--secondary);
  }
  .content {
    min-width: 0;
    max-width: 52rem;
  }

  /* ── Sections ── */
  .section {
    margin-block-end: 6rem;
    scroll-margin-top: 6rem;
  }
  .intro {
    max-width: 38rem;
    margin-block-end: 2.5rem;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--soft-foreground);
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--soft-foreground);
  }
  .prose p,
  .prose-p {
    max-width: 38rem;
    line-height: 1.85;
    color: var(--high-opacity-soft-foreground);
  }
  .prose p + p {
    margin-block-start: 1.25rem;
  }
  .block-fig {
    margin-block-start: 2rem;
  }

  /* ── Brief ── */
  .brief {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .brief {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: 3rem;
      align-items: start;
    }
  }
  .asks {
    padding: 1.5rem;
    border: 2px solid var(--low-opacity-soft-foreground);
    border-radius: 1.5rem;
  }
  .asks h3 {
    margin-block-end: 1rem;
    font-size: 1rem;
  }
  .asks ul,
  .asks li,
  .points li {
    position: relative;
    padding-inline-start: 1.4rem;
    line-height: 1.6;
    color: var(--high-opacity-soft-foreground);
  }
  .asks li + li,
  .points li + li {
    margin-block-start: 0.7rem;
  }
  /* Diamond bullet (nod to the lattice motif). */
  .asks li::before,
  .points li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0.1rem;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--secondary);
    transform: rotate(45deg);
  }

  /* ── Timeline ── */
  .timeline {
    border-inline-start: 2px solid var(--low-opacity-soft-foreground);
    margin-inline-start: 0.4rem;
  }
  .phase {
    position: relative;
    padding-inline-start: 2rem;
    padding-block-end: 3rem;
  }
  .phase:last-child {
    padding-block-end: 0;
  }
  .phase::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(-0.45rem - 1px);
    top: 0.3rem;
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--secondary);
    border-radius: 50%;
    background: var(--background);
  }
  .period {
    margin-block-end: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--secondary);
  }
  .phase h3 {
    margin-block-end: 0.6rem;
  }

  /* ── Decisions ── */
  .decisions {
    border-block-start: 1px solid var(--low-opacity-soft-foreground);
  }
  .decision {
    display: grid;
    gap: 1rem;
    padding-block: 2rem;
    border-block-end: 1px solid var(--low-opacity-soft-foreground);
  }
  @media (min-width: 720px) {
    .decision {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .chosen {
    margin-block-start: 0.6rem;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--secondary);
  }
  .chosen-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--mid-opacity-soft-foreground);
  }
  .considered {
    margin-block-start: 1rem;
    font-size: 0.9rem;
    color: var(--mid-opacity-soft-foreground);
  }
  .considered span {
    font-weight: 600;
  }

  /* ── Challenges ── */
  .challenges {
    display: grid;
    gap: 1.5rem;
  }
  .challenge {
    padding: 1.75rem;
    border: 2px solid var(--low-opacity-soft-foreground);
    border-radius: 1.5rem;
  }
  @media (min-width: 720px) {
    .challenge {
      padding: 2.25rem;
    }
  }
  .pair {
    display: grid;
    gap: 1.5rem;
    margin-block-start: 1.25rem;
  }
  @media (min-width: 720px) {
    .pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .pair-label {
    margin-block-end: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mid-opacity-soft-foreground);
  }
  .solution {
    padding-inline-start: 1.25rem;
    border-inline-start: 2px solid var(--secondary);
  }
  .solution .pair-label {
    color: var(--secondary);
  }

  /* ── Showcase ── */
  .showcase {
    display: grid;
    gap: 4rem;
  }
  .feature-text {
    display: grid;
    gap: 1.5rem;
    margin-block-start: 1.75rem;
  }
  @media (min-width: 720px) {
    .feature-text {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }
  .kind-tag {
    display: inline-block;
    margin-block-end: 0.75rem;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--low-opacity-soft-foreground);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--secondary);
  }
  .feature h3 {
    margin-block-end: 0.6rem;
    font-size: 1.6rem;
  }

  /* ── Learnings ── */
  .lessons {
    display: grid;
    gap: 2rem 3rem;
  }
  @media (min-width: 720px) {
    .lessons {
      grid-template-columns: 1fr 1fr;
    }
  }
  .lessons li {
    padding-block-start: 1.25rem;
    border-block-start: 2px solid var(--secondary);
  }
  .lessons h3 {
    margin-block-end: 0.5rem;
  }
  .closing {
    max-width: 40rem;
    margin-block-start: 3.5rem;
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
    line-height: 1.6;
    font-weight: 600;
    color: var(--soft-foreground);
  }
  .section:last-of-type {
    margin-block-end: 3.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc a {
      transition: none;
    }
  }

  /* Scroll-spy: a section is "active" while it crosses a thin band near the top
     of the viewport (view-timeline-inset trims 20% off the top, 68% off the
     bottom). Browsers without scroll-driven animations just show no highlight. */
  @supports (animation-timeline: view()) {
    .section {
      view-timeline-inset: 20% 68%;
    }
    .toc a {
      animation: toc-active linear both;
    }
  }
  @keyframes toc-active {
    1%,
    99% {
      color: var(--secondary);
      border-inline-start-color: var(--secondary);
    }
  }
</style>
