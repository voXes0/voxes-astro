---
import { t, type Locale } from "@/i18n";
import type { WorkKind, WorkStatus } from "@/lib/works";
import styles from "./WorkMeta.module.css";

interface Props {
  locale: Locale;
  kind: WorkKind;
  status: WorkStatus;
  year: number;
}

const { locale, kind, status, year } = Astro.props;
const m = t(locale).works;
---

<div class={styles.meta}>
  <span class:list={[styles.tag, styles.kind]} data-kind={kind}>
    <span class={styles.dot} aria-hidden="true"></span>
    {m.kind[kind]}
  </span>
  <span class:list={[styles.tag, styles.status]} data-status={status}>
    {status === "live" && <span class={styles.dot} aria-hidden="true" />}
    {m.status[status]}
  </span>
  <span class={styles.year}>{year}</span>
</div>
