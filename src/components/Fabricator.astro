---
/**
 * The "laser fabrication" stage: a faint baseplate grid with an empty SVG
 * stage on top. Markup only — what gets drawn lives in src/fab/pieces/, how it
 * is drawn in src/fab/engine.ts, and src/fab/autoMount.ts (loaded by
 * BaseLayout) brings it to life. Fills its nearest positioned ancestor, so the
 * parent decides size, background and clipping.
 *
 * Everything inside #fab-stage is in stage units. viewport.ts resizes the viewBox
 * to the component (300x300 here is only the first paint).
 */
import styles from "./Fabricator.module.css";
---

<div class={styles.root}>
  <!-- faint baseplate grid, sells the "fabrication bed" framing -->
  <svg class={styles.grid} aria-hidden="true">
    <defs>
      <pattern
        id="fabgrid"
        width="28"
        height="28"
        patternUnits="userSpaceOnUse"
      >
        <path d="M28 0H0V28" fill="none" stroke="currentColor" stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#fabgrid)"></rect>
  </svg>

  <svg
    id="fab-stage"
    viewBox="0 0 300 300"
    preserveAspectRatio="xMidYMid meet"
    class={styles.stage}
    aria-hidden="true"
  >
    <defs>
      <!-- glow for the head, in stage units -->
      <filter id="fab-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="0.76" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
      <!-- Strokes get their own glow filter per piece: the engine creates it with the
           piece (the blur has to be rescaled to the piece's size) and removes it after. -->

      <!-- the sun's bloom, in the scene's own colour (src/fab/pieces/sun.ts fills a circle with it) -->
      <radialGradient id="fab-sun-bloom">
        <stop
          offset="0"
          class={styles.bloomStop}
          stop-opacity="0.45"></stop>
        <stop
          offset="0.35"
          class={styles.bloomStop}
          stop-opacity="0.2"></stop>
        <stop
          offset="0.7"
          class={styles.bloomStop}
          stop-opacity="0.05"></stop>
        <stop offset="1" class={styles.bloomStop} stop-opacity="0"
        ></stop>
      </radialGradient>
    </defs>

    <!-- Head first, so strokes paint over it (as it always has). A triangle
         spins around the dot; position and spin never fight over one attribute. -->
    <g id="fab-head-group" class={styles.headGroup}>
      <polygon
        id="fab-head-triangle"
        points="0,-12.41 10.74,6.21 -10.74,6.21"
        fill="none"
        stroke="currentColor"
        stroke-width="0.76"
        stroke-linejoin="round"
        class={styles.headTrail}
        filter="url(#fab-glow)"></polygon>
      <circle
        id="fab-head"
        r="2.5"
        class={styles.headDot}
        filter="url(#fab-glow)"></circle>
    </g>
    <!-- one <g> per piece is created here while it is on stage (piece sequencer) -->
    <g id="fab-layer"></g>
    <!-- camera chapters: the world, panned by src/fab/camera.ts (the edge fade is CSS, on the stage) -->
    <g id="fab-view">
      <g id="fab-world"></g>
    </g>
    <!-- non-stroke extras acts add (e.g. the wordmark), in stage space -->
    <g id="fab-overlay"></g>
  </svg>
</div>
