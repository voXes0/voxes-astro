---
/**
 * A small flappy-bird mini-game, reusable anywhere: `<FlappyBird locale={locale} />`.
 *
 * The bird is the fabricator's own (src/fab/pieces/bird.strokes.ts, so it
 * follows art/bird.svg when that is redrawn), minus its legs, which it tucks
 * in flight. Markup and look live here; the rules are src/flappy/physics.ts,
 * the drawing and input src/flappy/game.ts, and src/flappy/autoMount.ts
 * (loaded by BaseLayout) brings it to life. Levels are data: src/flappy/levels.ts.
 *
 * Fills the width its parent gives it (3:2). Colours all come from the site's
 * tokens, so it follows light / dark mode by itself.
 */
import { strokes } from "@/fab/pieces/bird.strokes";
import { isRtl, t, type Locale } from "@/i18n";
import { BIRD, WORLD } from "@/flappy/config";
import { defaultLevelId } from "@/flappy/levels";
import ButtonLink from "./ButtonLink.astro";

interface Props {
  locale: Locale;
  /** A key of `levels` in src/flappy/levels.ts. */
  level?: string;
  /**
   * "visible": Space / ↑ / W work whenever the game is on screen (right for a
   * page whose point is the game). "focus": only while it has focus, so it
   * never steals Space from the page's own scrolling.
   */
  keys?: "visible" | "focus";
  /**
   * Suffix for this instance's SVG filter / pattern ids. Defaults to the level,
   * so give two games with the same level on one page different ids.
   */
  id?: string;
  class?: string;
}

const { locale, level = defaultLevelId, keys = "visible", id = level, class: className } = Astro.props;
const m = t(locale).flappy;
const dir = isRtl(locale) ? "rtl" : "ltr";

// Stable ids (not random) keep builds reproducible.
const uid = `flappy-${id}`;

const art = strokes.filter((s) => !/^(leg|feet)/.test(s.id));
const scale = BIRD.width / BIRD.artWidth;
const lineWidth = BIRD.strokeWidth / scale;
const { x: cx, y: cy } = BIRD.center;
---

<div
  class:list={["flappy", className]}
  data-flappy
  data-level={level}
  data-keys={keys}
  data-locale={locale}
  data-state="ready"
  role="group"
  aria-label={m.label}
  tabindex="0"
  dir="ltr"
>
  <svg
    class="stage"
    viewBox={`0 0 ${WORLD.w} ${WORLD.h}`}
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <pattern
        id={`${uid}-grid`}
        width={WORLD.grid}
        height={WORLD.grid}
        patternUnits="userSpaceOnUse"
      >
        <path d={`M${WORLD.grid} 0H0V${WORLD.grid}`} fill="none" class="grid-line"></path>
      </pattern>
      <!-- The fabricator's soft glow, much subtler than the bird's 0.35. -->
      <filter id={`${uid}-glow`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="0.9" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- Baseplate grid, drifting slower than the gates (parallax). -->
    <g data-flappy-bg>
      <rect x="-28" y="0" width={WORLD.w + 56} height={WORLD.h} fill={`url(#${uid}-grid)`}></rect>
    </g>

    <!-- Gates and finish line scroll here (built by game.ts). -->
    <g data-flappy-world></g>

    <rect class="floor" x="0" y={WORLD.floorY} width={WORLD.w} height={WORLD.h - WORLD.floorY}></rect>
    <line
      class="ground"
      data-flappy-ground
      x1="0"
      y1={WORLD.floorY}
      x2={WORLD.w}
      y2={WORLD.floorY}
      stroke-dasharray={WORLD.groundDash.join(" ")}
    ></line>

    <!-- game.ts places and tilts this group; the inner one centres the art on the body. -->
    <g data-flappy-bird transform={`translate(${BIRD.x} ${BIRD.startY})`}>
      <g class="bird" transform={`scale(${scale}) translate(${-cx} ${-cy})`}>
        <!-- Crisp fills first, glowing outlines on top (as in the fabricator). -->
        {
          art
            .filter((s) => s.fill)
            .map((s) => (
              <path
                d={s.d}
                fill={s.fillColor ?? "currentColor"}
                fill-opacity={s.fillColor ? 1 : 0.58}
              />
            ))
        }
        <g
          fill="none"
          stroke="currentColor"
          stroke-width={lineWidth}
          stroke-linecap="round"
          stroke-linejoin="round"
          filter={`url(#${uid}-glow)`}
        >
          {art.map((s) => <path d={s.d} data-flappy-wing={s.id === "wing" ? "" : undefined} />)}
        </g>
      </g>
    </g>
  </svg>

  <!-- Gates cleared and progress to the finish line. -->
  <div class="hud" aria-hidden="true">
    <span class="hud-label" dir={dir}>{m.gates}</span>
    <span class="hud-count" data-flappy-count>0 / 0</span>
    <span class="hud-track"><span class="hud-bar" data-flappy-bar></span></span>
  </div>

  <div class="overlay overlay-hint" data-flappy-overlay="ready" dir={dir} lang={locale}>
    <p class="ov-title">{m.ready.title}</p>
    <p class="ov-body">{m.ready.hint}</p>
  </div>

  <div class="overlay" data-flappy-overlay="paused" dir={dir} lang={locale}>
    <p class="ov-title">{m.paused.title}</p>
    <p class="ov-body">{m.paused.hint}</p>
  </div>

  <div class="overlay" data-flappy-overlay="lost" dir={dir} lang={locale}>
    <p class="ov-title">{m.lost.title}</p>
    <p class="ov-body" data-template={m.lost.body}>{m.lost.body}</p>
    <ButtonLink size="sm" data-flappy-retry="">{m.lost.action}</ButtonLink>
  </div>

  <div class="overlay" data-flappy-overlay="won" dir={dir} lang={locale}>
    <p class="ov-title">{m.won.title}</p>
    <p class="ov-body" data-template={m.won.body}>{m.won.body}</p>
    <ButtonLink size="sm" data-flappy-retry="">{m.won.action}</ButtonLink>
  </div>

  <!-- Screen readers hear the result here; hidden overlays are out of the a11y tree via visibility. -->
  <p class="sr-only" role="status" aria-live="polite" data-flappy-live></p>
</div>

<style>
  .flappy {
    position: relative;
    width: 100%;
    aspect-ratio: 480 / 320;
    overflow: hidden;
    border: 1.5px solid var(--low-opacity-soft-foreground);
    border-radius: 1.25rem;
    background: color-mix(in oklab, var(--secondary) 9%, var(--background));
    color: var(--soft-foreground);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* Taps are flaps: no double-tap zoom or scroll gestures on the playfield. */
    touch-action: manipulation;
  }
  .flappy:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 3px;
  }
  .stage {
    width: 100%;
    height: 100%;
  }
  [data-state="crashed"] .stage {
    animation: flappy-shake 0.32s ease-out;
  }
  @keyframes flappy-shake {
    0%,
    100% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(-5px, 2px);
    }
    40% {
      transform: translate(4px, -3px);
    }
    60% {
      transform: translate(-3px, 2px);
    }
    80% {
      transform: translate(2px, -1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state="crashed"] .stage {
      animation: none;
    }
    .overlay {
      transition: none;
    }
  }

  /* ── Scene colours ── */
  .grid-line {
    stroke: color-mix(in oklab, var(--soft-foreground) 11%, transparent);
    stroke-width: 1;
  }
  .floor {
    fill: color-mix(in oklab, var(--soft-foreground) 9%, transparent);
  }
  .ground {
    stroke: var(--mid-opacity-soft-foreground);
    stroke-width: 2;
  }
  .bird {
    color: var(--secondary);
  }
  /* Built by game.ts, so they lack Astro's scoping attribute. */
  :global(.flappy-ob) {
    fill: color-mix(in oklab, var(--soft-foreground) 14%, transparent);
    stroke: var(--high-opacity-soft-foreground);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  :global(.flappy-finish) {
    fill: none;
    stroke: var(--secondary);
    stroke-width: 2;
    stroke-dasharray: 7 7;
  }
  :global(.flappy-flag) {
    fill: color-mix(in oklab, var(--secondary) 55%, transparent);
    stroke: var(--secondary);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  /* ── Progress ── */
  .hud {
    position: absolute;
    inset-block-start: 0.7rem;
    inset-inline: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soft-foreground);
    pointer-events: none;
  }
  .hud-label[dir="rtl"] {
    letter-spacing: 0;
  }
  .hud-count {
    font-variant-numeric: tabular-nums;
    direction: ltr;
  }
  .hud-track {
    flex: 1;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--low-opacity-soft-foreground);
    overflow: hidden;
  }
  .hud-bar {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--secondary);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ── Messages: one per state; the rest are invisible and unfocusable ── */
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    text-align: center;
    background: color-mix(in oklab, var(--background) 80%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  /* The "ready" hint sits over the scene without hiding it. */
  .overlay-hint {
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    justify-content: flex-end;
    padding-block-end: 3rem;
    pointer-events: none;
  }
  [data-state="ready"] [data-flappy-overlay="ready"],
  [data-state="paused"] [data-flappy-overlay="paused"],
  [data-state="lost"] [data-flappy-overlay="lost"],
  [data-state="won"] [data-flappy-overlay="won"] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .ov-title {
    font-size: clamp(1.4rem, 5vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: var(--soft-foreground);
  }
  .ov-body {
    max-width: 24rem;
    margin-block-end: 0.5rem;
    font-size: clamp(0.85rem, 2.6vw, 1rem);
    line-height: 1.6;
    color: var(--soft-foreground);
  }
  .overlay-hint .ov-title {
    font-size: clamp(1.05rem, 3.6vw, 1.4rem);
  }
  .overlay-hint .ov-body {
    margin: 0;
    color: var(--high-opacity-soft-foreground);
  }
</style>
